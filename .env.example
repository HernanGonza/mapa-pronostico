# Copiá a `.env` (gitignoreado) y completá antes de `docker compose up`.

# --- Postgres (corre en su propio container, sin acceso desde afuera) ---
POSTGRES_USER=mapa
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=mapa_pronostico

# --- Dominio público (Caddy pide TLS automático si es un dominio real) ---
# En local dejalo en localhost — Caddy sirve HTTP plano sin intentar ACME.
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# --- Front: vacío = mismo origen (recomendado, ver docker-compose.yml) ---
VITE_API_URL=

# --- Solo si el back se expone también en otro origen aparte de Caddy ---
CORS_ORIGIN=

# --- Alertas de incendios: token fijo para el webhook del otro sistema ---
# Generá algo random largo (ej. `openssl rand -hex 32`).
ALERTAS_INCENDIOS_TOKEN=
# Fallback manual (pull) — todavía no confirmado.
ALERTAS_INCENDIOS_URL=
