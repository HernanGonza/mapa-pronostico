# Copiá a .env (o .env.local) y completá.

# Puerto (Render lo setea solo; en local, opcional).
# PORT=3000

# Postgres para guardar el pronóstico publicado + historial.
# - Producción: el Supabase self-hosted de "ecodatos" (mismo servidor,
#   otra VM), vía el pooler Supavisor en modo *session* (no transaction:
#   no sostiene bien el search_path por conexión). Usuario en formato
#   multi-tenant `postgres.<POOLER_TENANT_ID>` — ver ecodatos/.env.
# - Sin esta variable, el backend guarda en data/store/ en disco (sin historial).
# DATABASE_URL=postgresql://postgres.<tenant>:<password>@<host-ecodatos>:5432/postgres?sslmode=disable
# El Postgres de ecodatos no tiene TLS habilitado.
# DATABASE_SSL=false
# Schema propio dentro de esa base compartida, para no pisar las tablas
# de otros servicios de ecodatos (default: alerta_temprana).
# DATABASE_SCHEMA=alerta_temprana

# Orígenes permitidos para CORS en producción (coma-separado).
# Sin esta variable se permite cualquier origen.
# CORS_ORIGIN=https://mapa-pronostico.vercel.app

# --- Supabase Storage (placas de alertas meteorológicas: feed + historias) ---
# Mismo Supabase self-hosted de ecodatos que DATABASE_URL de arriba, pero
# por su API REST (no hace falta @supabase/supabase-js, ver lib/storage.js).
# SUPABASE_URL=https://ecodatos.ecologia.misiones.gob.ar
# SUPABASE_SERVICE_ROLE_KEY=
# Bucket donde se guardan las placas (default: alerta-temprana). Se crea
# una sola vez a mano, público (son imágenes para difundir en redes).
# SUPABASE_STORAGE_BUCKET=alerta-temprana

# --- Alertas de incendios ---

# Token fijo que tiene que mandar el sistema de alertas en el header
# `X-Api-Key` al pegarle a POST /api/incendios/webhook. Generá algo random
# largo (ej. `openssl rand -hex 32`) y pasáselo al otro equipo.
# ALERTAS_INCENDIOS_TOKEN=

# Endpoint del sistema de alertas de incendio (devuelve un array de focos,
# ver forma esperada en mapa-frontend/src/lib/alertasIncendio.js). Con esta
# variable puesta el backend lo consulta solo al arrancar y cada 5 minutos
# (igual que el sondeo del SMN) — no hace falta tocar nada más. El botón
# "Recuperar" del panel sigue disponible para forzar una actualización.
# ALERTAS_INCENDIOS_URL=
# Desactivar el sondeo automático de arriba (deja solo el botón manual y el webhook).
# ALERTAS_INCENDIOS_SYNC_ENABLED=false

# SMN RSS/CAP (única vía de ingesta; ver mapa-backend/src/lib/smn):
# consulta inmediata al arrancar y cada 5 minutos.
# Usa DATABASE_URL y el pool existente; sin base, persiste en data/store.
# Desactivar en réplicas web si se dedica una única instancia al sondeo.
SMN_SYNC_ENABLED=true
# Alcance de la aplicación: solo Misiones.
SMN_SCOPE=misiones

# --- Chromium (placas de alertas meteorológicas, lib/generateAlertaMap.js) ---
# Necesita un binario de Chromium instalado en la imagen (puppeteer-core,
# sin navegador propio incluido) — ver Dockerfile — y esta ruta si no es
# la default de Debian/Ubuntu (/usr/bin/chromium):
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
