# URL del backend (Express). En Vercel se setea en el dashboard.
VITE_API_URL=http://localhost:3000

# Spike Babylon geoespacial (/3d-tiles). Crear un token de sólo lectura en
# Cesium ion; el asset 2275207 corresponde a Google Photorealistic 3D Tiles.
VITE_CESIUM_ION_TOKEN=
VITE_CESIUM_ION_ASSET_ID=2275207
# Alternativa para un tileset propio (si se define, reemplaza el asset ion):
VITE_3D_TILES_ROOT_URL=
VITE_HORIZON_STORM_VIDEO_URL=
