# URL del backend (Express). En Vercel se setea en el dashboard.
VITE_API_URL=http://localhost:3000

# Token de cliente de Mapillary (gratis, solo lectura):
# https://www.mapillary.com/dashboard/developers
# Con esto, la "vista a nivel calle" embebe el visor navegable mapillary-js.
# Sin esto, el panel ofrece enlaces a Mapillary / Panoramax / Google.
# VITE_MAPILLARY_TOKEN=MLY|xxxxxxxxxxxx|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
