# DOMAIN: dominio real (Caddy pide el certificado TLS solo automáticamente)
# o "localhost" para HTTPS con certificado local de Caddy.
{$DOMAIN:localhost} {
	encode gzip

	# Registro de cada pedido (IP, User-Agent, código de respuesta) en los logs
	# del contenedor: `docker compose logs -f frontend`. Sirve para ver si un
	# pedido llegó hasta acá o lo cortó algo antes (firewall, HAProxy).
	log {
		output stdout
		format console
	}

	# Todo lo que sirve el backend, proxeado bajo el mismo origen: así el
	# front nunca necesita CORS, aunque en dev (dos puertos) siga hacen falta.
	@backend path /api/* /glyphs/* /materiales/* /health
	handle @backend {
		reverse_proxy backend:3000
	}

	# El resto: el SPA. Fallback a index.html para las rutas de React Router
	# (/admin, /embed) — si no, un F5 en /embed tira 404. `{path}.html` sirve
	# las páginas estáticas de public/ con URL limpia (/privacidad →
	# privacidad.html): Meta las lee sin ejecutar JavaScript.
	handle {
		root * /srv
		# Los JS/CSS de /assets llevan un hash en el nombre: se pueden guardar
		# para siempre. Todo lo demás (index.html, páginas estáticas) se
		# revalida en cada visita; si no, después de un deploy el navegador
		# sigue usando la versión vieja (pasó con el iframe de avisos).
		@assets path /assets/*
		@resto not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @resto Cache-Control "no-cache"
		try_files {path} {path}.html /index.html
		file_server
	}
}
